{
  "expo": {
    "name": "HomeChef AI",
    "slug": "homechef-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "homechef",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fafaf9",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafaf9"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homechef.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "HomeChef AI needs microphone access so Grace can guide you through recipes hands-free.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.homechef.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fafaf9"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "homechef"
            },
            {
              "scheme": "exp+homechef-mobile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "HomeChef AI needs microphone access so Grace can guide you through recipes hands-free."
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-asset",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
